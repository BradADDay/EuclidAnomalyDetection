@article{copin_euclid_2026,
	title = {Euclid {Quick} {Data} {Release} ({Q1}) - {VI}. {From} spectrograms to spectra: {The} {SIR} spectroscopic processing function},
	volume = {711},
	copyright = {© The Authors 2026},
	issn = {0004-6361, 1432-0746},
