@article{neloy_comprehensive_2024,
	title = {A comprehensive study of auto-encoders for anomaly detection: {Efficiency} and trade-offs},
	volume = {17},
	issn = {26668270},
	shorttitle = {A comprehensive study of auto-encoders for anomaly detection},
	url = {https://linkinghub.elsevier.com/retrieve/pii/S2666827024000483},
	doi = {10.1016/j.mlwa.2024.100572},
	abstract = {Unsupervised anomaly detection (UAD) is a diverse research area explored across various application domains. Over time, numerous anomaly detection techniques, including clustering, generative, and variational inferencebased methods, are developed to address specific drawbacks and advance state-of-the-art techniques. Deep learning and generative models recently played a significant role in identifying unique challenges and devising advanced approaches. Auto-encoders (AEs) represent one such powerful technique that combines generative and probabilistic variational modeling with deep architecture. Auto-Encoder aims to learn the underlying data distribution to generate consequential sample data. This concept of data generation and the adoption of generative modeling have emerged in extensive research and variations in Auto-Encoder design, particularly in unsupervised representation learning. This study systematically reviews 11 Auto-Encoder architectures categorized into three groups, aiming to differentiate their reconstruction ability, sample generation, latent space visualization, and accuracy in classifying anomalous data using the Fashion-MNIST (FMNIST) and MNIST datasets. Additionally, we closely observed the reproducibility scope under different training parameters. We conducted reproducibility experiments utilizing similar model setups and hyperparameters and attempted to generate comparative results to address the scope of improvements for each Auto-Encoder. We conclude this study by analyzing the experimental results, which guide us in identifying the efficiency and trade-offs among auto-encoders, providing valuable insights into their performance and applicability in unsupervised anomaly detection techniques.},
	language = {en},
	urldate = {2026-11-12},
	journal = {Machine Learning with Applications},
	author = {Neloy, Asif Ahmed and Turgeon, Maxime},
	month = sep,
	year = {2024},
	pages = {100572},
	file = {PDF:/home/brad/Zotero/storage/7PW5CBY5/Neloy and Turgeon - 2024 - A comprehensive study of auto-encoders for anomaly detection Efficiency and trade-offs.pdf:application/pdf},
}

@article{mccracken_euclid_2026,
	title = {Euclid {Quick} {Data} {Release} ({Q1}) - {II}. {VIS} processing and data products},
	volume = {711},
	copyright = {© The Authors 2026},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2026/07/aa54594-25/aa54594-25.html},
	doi = {10.1051/0004-6361/202554594},
	abstract = {This paper describes the VIS processing function (VIS PF) of the {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater} ground segment pipeline, which processes and calibrates raw data from the VIS camera. We present the algorithms used in each processing element along with a description of the on-orbit performance of VIS PF based on performance verification and Q1 datasets. We demonstrate that the principal performance metrics (image quality, astrometric accuracy, photometric calibration) are within pre-launch specifications. The image-to-image photometric scatter is less than 0.8\% and absolute astrometric accuracy compared to Gaia is 5 mas. Image quality is stable over all Q1 images, with a full width at half maximum (FWHM) of 0 16. The stacked images (combining four nominal and two short exposures) reach {\textless}i{\textgreater}I{\textless}i/{\textgreater}{\textless}sub{\textgreater}E{\textless}sub/{\textgreater} = 25.6 (10{\textless}i{\textgreater}σ{\textless}i/{\textgreater}, measured as the variance of 1 3 diameter apertures). We also describe quality control metrics provided with each image, and an appendix provides a detailed description of the provided data products. The excellent quality of these images demonstrates the immense potential of {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater} VIS data for weak lensing. VIS data covering most of the extragalactic sky will provide a lasting high-resolution atlas of the Universe.},
	language = {en},
	urldate = {2026-11-14},
