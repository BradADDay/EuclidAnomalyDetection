@article{aussel_euclid_2026,
	title = {Euclid {Quick} {Data} {Release} ({Q1}) - {I}. {Data} release overview},
	volume = {711},
	copyright = {© The Authors 2026},
	issn = {0004-6361, 1432-0746},
	url = {https://www.aanda.org/articles/aa/abs/2026/07/aa54610-25/aa54610-25.html},
	doi = {10.1051/0004-6361/202554610},
	abstract = {The first {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater} Quick Data Release, Q1, comprises 63.1 deg{\textless}sup{\textgreater}2{\textless}sup/{\textgreater} of the Euclid Deep Fields (EDFs) to the nominal wide-survey depth. It encompasses visible and near-infrared space-based imaging and spectroscopic data, ground-based photometry in the {\textless}i{\textgreater}u{\textless}i/{\textgreater}, {\textless}i{\textgreater}g{\textless}i/{\textgreater}, {\textless}i{\textgreater}r{\textless}i/{\textgreater}, {\textless}i{\textgreater}i{\textless}i/{\textgreater}, and {\textless}i{\textgreater}z{\textless}i/{\textgreater} bands, as well as corresponding masks. Overall, Q1 contains about 30 million objects in three areas near the ecliptic poles around EDF-North and EDF-South, as well as the EDF-Fornax field in the constellation of the same name. The purpose of this data release – and its associated technical papers – is twofold. First, it is meant to inform the community of the enormous potential of the {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater} survey data, to describe what is contained in these data, and to help prepare expectations for the forthcoming first major data release DR1. Second, it enables a wide range of initial scientific projects with wide-survey {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater} data, ranging from the early Universe to the Solar System. The Q1 data were processed with early versions of the processing pipelines, which already demonstrate a good performance, with numerous improvements in implementation compared to pre-launch development. In this paper, we describe the sky areas released in Q1, the observations, a top-level view of the data processing of {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater} and associated external data, the Q1 photometric masks, and how to access the data. We also give an overview of initial scientific results obtained using the Q1 dataset by Euclid Consortium scientists, and conclude with important caveats when using the data. As a complementary product, Q1 also contains observations of a star-forming area in Lynd’s Dark Nebula 1641 in the Orion A Cloud, observed for technical purposes during {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater}’s performance-verification phase. This is a unique target, of a type not commonly found in {\textless}i{\textgreater}Euclid{\textless}i/{\textgreater}’s nominal sky survey.},
